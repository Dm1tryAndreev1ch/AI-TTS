AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9092
MAX_CALLS=1
CALL_TIMEOUT_SEC=600
ECHO_AUDIO=false

# Local LLM (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Leave empty to use built-in DEMO data / console CRM in the demos
ONEC_URL=
ONEC_TOKEN=
BITRIX_WEBHOOK=
DEMO_CALLER_PHONE=+375290000000

# Voice demo (python -m gateway.voice_cli)
WHISPER_MODEL=small
PIPER_VOICE=models/ru_RU-irina-medium.onnx
VOICE_PLAYER=afplay

# Phone mode (python -m gateway.telephony_cli). It binds to TELEPHONY_BIND only, never to AUDIOSOCKET_HOST.
TELEPHONY_BIND=127.0.0.1
